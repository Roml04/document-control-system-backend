APP_NAME="Document Control System"
# ==== [ APP_ENV ] ====
# Set the value to "production" when the project
# is ready to be deployed. Set the value to "local"
# when the project is in development
APP_ENV=local
# ==== [ APP_KEY ] ====
# The key generated by the app using the built-in
# command php artisan key:generate
APP_KEY=
# ==== [ APP_DEBUG ] ====
# Set the value to "false" when the project
# is ready to be deployed. Set the value to "true"
# when the project is in development
APP_DEBUG=true
# ==== [ APP_URL ] ====
# Base URL of the Laravel application, used for generating 
# absolute URLs in links, redirects, and notifications.
# Set this to the application's actual URL based on the 
# hosting environment (e.g., localhost, server IP, or
# domain name
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==== [ MAIL_MAILER ] ====
# Replace the value with "resend" to enable
# mails to be sent through resend's API
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# ==== [ MAIL_FROM_ADDRESS ] ====
# You may specify a custom email address using the company's domain 
# (e.g., dcs.mailbox@toyotasantarosa.com.ph). The email address itself 
# does not need to exist, but the domain (e.g., toyotasantarosa.com.ph) 
# must be valid and registered
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==== [ RESEND_API_KEY ] ====
# The API key provided by Resend once an account was registered and a domain
# is added on the resend dashboard
RESEND_API_KEY=
