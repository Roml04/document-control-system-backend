FROM serversideup/php:8.5-fpm-nginx

ARG uSER_ID
ARG GROUP_ID

USER root
RUN docker-php-serversideup-set-id www-data $USER_ID:$GROUP_ID \
  && docker-php-serversideup-set-file-permissions --owner $USER_ID:$GROUP_ID --service nginx
RUN mkdir -p /var/www/html/vendor /var/www/html/storage/app/private \
 && chown -R www-data:www-data /var/www/html/vendor /var/www/html/storage/app/private
USER www-data